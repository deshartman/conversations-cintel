# Copy this file to .env and update with your values.

# Twilio
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_API_KEY=xxxx
TWILIO_API_SECRET=xxxx
TWILIO_PHONE_NUMBER=+1234567890

# Conversation Orchestrator + Memory
TWILIO_MEMORY_STORE_ID=mem_store_xxxxxxxxx
TWILIO_CONVERSATION_CONFIGURATION_ID=conv_configuration_xxxxxxxx
TWILIO_MEMORY_PROFILE_ID=mem_profile_xxxxxxxxx
TWILIO_MEMORY_PROFILE_TRAIT_GROUPS=Loyalty,Travel

# Conversation Intelligence (helpers only; the app gets it via the Orchestrator Configuration)
TWILIO_INTELLIGENCE_CONFIGURATION_ID=intelligence_configuration_xxxxxxxx

# Conversation Intelligence webhook (read by TAC). When set, the app serves POST /ci-webhook and the
# dashboard shows operator results. Must be the Intelligence configuration whose rule has the webhook
# action. Leave empty to keep /ci-webhook off.
TWILIO_TAC_CI_CONFIGURATION_ID=
# Optional: summary operator ID. When set, TAC writes that operator's summaries into Memory.
TWILIO_TAC_CI_SUMMARY_OPERATOR_SID=

# Voice (ConversationRelay) public host
TWILIO_VOICE_PUBLIC_DOMAIN=your-domain.ngrok.io

# Demo phone numbers
DEMO_CALLER_PHONE_NUMBER=+1234567890

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Server
PORT=8000
